  talkScript:
  - name1: 
    character1: {fileID: 0}
    name2: Marcus Backs
    character2: {fileID: 21300000, guid: ffd2326f261fed243a9c2e82e8415299, type: 3}
    LeftTalk: 0
    text: Eai tudo bem? precisa de alguma coisa?
  - name1: Derik
    character1: {fileID: 7083445097920205109, guid: 5d65264f09c85b34c9d325e921a3b4a7, type: 3}
    name2: 
    character2: {fileID: 0}
    LeftTalk: 1
    text: Por enquanto nada, mas muito obrigado mesmo assim
  - name1: 
    character1: {fileID: 0}
    name2: 
    character2: {fileID: 21300000, guid: ffd2326f261fed243a9c2e82e8415299, type: 3}
    LeftTalk: 0
    text: "Beleza ent\xE3o quando precisar pode falar"
  - name1: Derik
    character1: {fileID: 7083445097920205109, guid: 5d65264f09c85b34c9d325e921a3b4a7, type: 3}
    name2: 
    character2: {fileID: 0}
    LeftTalk: 1
    text: "Na verdade pensei agora, tem um emprego que pague mais de 8 mil conto
      pra mim a\xED??"
  - name1: 
    character1: {fileID: 0}
    name2: 
    character2: {fileID: 21300000, guid: ffd2326f261fed243a9c2e82e8415299, type: 3}
    LeftTalk: 0
    text: "8 mil conto a\xED voc\xEA me complica, mas quando vier a oportunidade
      te aviso"
