  m_Script: {fileID: 11500000, guid: 68e5d0eec83c9324a81e5711e7da3143, type: 3}
  m_Name: Attack
  m_EditorClassIdentifier: 
  mechanicName: ATAQUE
  mechanicView: {fileID: 21300000, guid: 6b7d0ead6b6441d4c8ae711acabedc03, type: 3}
  mechanicDescription: "Um ataque \xE9 uma a\xE7\xE3o realizada por um jogador para
    causar dano a um inimigo ou alvo em um jogo, geralmente envolvendo a execu\xE7\xE3o
    de uma habilidade ou uso de uma arma."
  stepsQuantity:
  - stepText: "Se clicar bot\xE3o de ataque"
  - stepText: "Anima\xE7\xE3o de ataque"
  - stepText: Se detectar que colidiu
  - stepText: Aplicar dano ao inimigo
  - stepText: Retornar ao estado padrao
  totalReward: 400
  secondReward: 300
  thirdReward: 200
  fourthReward: 100
  mechanicExplanation: "Um ataque em um jogo come\xE7a com a entrada do jogador,
    desencadeando uma anima\xE7\xE3o e a detec\xE7\xE3o de colis\xE3o. O dano \xE9
    calculado, aplicado ao inimigo, e o estado do personagem \xE9 atualizado para
    retornar ao estado padrao do player."
